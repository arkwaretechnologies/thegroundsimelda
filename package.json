{
  "name": "the-grounds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){if(e.code!=='ENOENT')throw e}\"",
    "predev": "node scripts/check-dev-port.mjs",
    "dev": "next dev --turbopack",
    "dev:stable": "node scripts/check-dev-port.mjs && next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "bench:slots": "node scripts/bench-exclusive-slots.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.4",
